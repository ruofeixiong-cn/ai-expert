# ─── Postgres ────────────────────────────────────────────────
POSTGRES_DB=ai_expert
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# app_owner：仅用于迁移（DDL）。生产环境不要给运行时用。
DATABASE_URL_OWNER=postgres://app_owner:owner_dev_pw@localhost:5432/ai_expert
# app_backend：Node 运行时。RLS 生效。
DATABASE_URL_BACKEND=postgres://app_backend:backend_dev_pw@localhost:5432/ai_expert
# app_agent：Python 运行时。RLS 生效 + 只能碰 chunks/build_jobs/experts。
DATABASE_URL_AGENT=postgresql+asyncpg://app_agent:agent_dev_pw@localhost:5432/ai_expert

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── 服务地址 ─────────────────────────────────────────────────
BACKEND_PORT=8787
AGENT_PORT=8000
AGENT_URL=http://localhost:8000
FRONTEND_PORT=5173
# 分享链接 /s/{slug} 的对外地址。
# 本地必须设成前端地址 —— dev 下这个路由由 Vite 提供，backend 上没有它，
# 不设的话上线拿到的分享链接是个 404（而接口返回 200，数据全对）。
# 生产上留空即可：那时 /s/:slug 由 backend 渲染 og 壳，域名就是 API 域名。
PUBLIC_WEB_URL=http://localhost:5173

# backend → agent 的内网共享密钥。agent 永不对公网开放。
INTERNAL_TOKEN=dev_internal_token_change_me

# 运行环境。设为 production 时，backend 与 agent 检测到开发默认值
# （JWT_SECRET、INTERNAL_TOKEN、数据库开发密码）会直接拒绝启动。
NODE_ENV=development
# 生产必填，至少 32 位随机串。本地留空则用开发默认值。
# JWT_SECRET=

# 链接抓取额外放行的网段，【只在本机用】。开着代理 fake-ip 模式（Clash / Surge）时
# 所有域名都解析到 198.18.x.x，会被 SSRF 防护当成保留地址拦下 —— 那时填 198.18.0.0/15。
# 生产环境设了它，agent 会拒绝启动。
FETCH_TRUSTED_CIDRS=

# ─── 百炼 ─────────────────────────────────────────────────────
# 以下模型 ID 已于 2026-09-09 用真实 key 实测可用：
#   对话     qwen-plus / qwen-max / qwen3-max / qwen3.5-plus / qwen-turbo
#   向量     text-embedding-v3 / text-embedding-v4（均支持 dimensions=1024）
#   重排序   gte-rerank-v2 ✓　gte-rerank ✗ 403 AccessDenied（v1 已不可用）
#
# ⚠️ rerank 分数分布偏低：实测"高度相关"文档只有 0.2956，无关文档 0.0059。
#    区分度够（约 50 倍），但【绝对值低】—— M3 的 Confidence 阈值绝不能
#    按直觉设 0.5/0.7，否则会把所有召回结果全滤掉。先按 0.05 起步再用
#    黄金问答集校准。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_CHAT=qwen-plus
MODEL_EXTRACT=qwen-max
MODEL_EMBEDDING=text-embedding-v3
MODEL_RERANK=gte-rerank-v2
EMBEDDING_DIM=1024
# auto = 有 key 用百炼，没 key 用确定性假向量（CI / 无网开发）
# 可强制为 dashscope / fake
EMBEDDING_PROVIDER=auto
EXTRACT_PROVIDER=auto
CHAT_PROVIDER=auto
RERANK_PROVIDER=auto

# 入口闸门阈值。⚠️ 实测 gte-rerank-v2 的分数分布偏低：
#   "定投手续费" vs 高度相关的原文 → 0.2246
#   完全无关的内容                → 0.0059
# 按直觉设 0.5 会把所有召回结果滤光，表现成"专家什么都不知道"。
# 改这个值请在 agent/app/pipeline/config.py，这里只是提醒。
