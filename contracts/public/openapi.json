{
  "openapi": "3.1.0",
  "info": {
    "title": "AI 专家平台 · 公开 API",
    "version": "0.0.1",
    "description": "前端唯一的 API 面。agent 服务只在内网可达，不出现在这份契约里。"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "HealthData": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "example": "backend"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "service",
          "status"
        ]
      },
      "ReadyData": {
        "type": "object",
        "properties": {
          "database": {
            "type": "string",
            "enum": [
              "ok",
              "down"
            ]
          },
          "agent": {
            "type": "string",
            "enum": [
              "ok",
              "down"
            ]
          }
        },
        "required": [
          "database",
          "agent"
        ]
      },
      "UserPublic": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          },
          "nickname": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "creator",
              "user"
            ]
          }
        },
        "required": [
          "id",
          "email",
          "phone",
          "nickname",
          "role"
        ]
      },
      "TenantPublic": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "AuthResult": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "JWT，放 Authorization: Bearer <token>"
          },
          "user": {
            "$ref": "#/components/schemas/UserPublic"
          },
          "tenant": {
            "$ref": "#/components/schemas/TenantPublic"
          }
        },
        "required": [
          "token",
          "user",
          "tenant"
        ]
      },
      "ErrorBody": {
        "type": "object",
        "properties": {
          "code": {
            "type": "number",
            "example": 1401
          },
          "message": {
            "type": "string",
            "example": "未登录"
          },
          "data": {
            "type": "null"
          }
        },
        "required": [
          "code",
          "message",
          "data"
        ]
      },
      "RegisterInput": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string",
            "minLength": 6,
            "maxLength": 20
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 72,
            "description": "至少 8 位"
          },
          "nickname": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "required": [
          "password"
        ]
      },
      "LoginInput": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string",
            "minLength": 1,
            "description": "邮箱或手机号"
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "account",
          "password"
        ]
      },
      "MeResult": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserPublic"
          },
          "tenant": {
            "$ref": "#/components/schemas/TenantPublic"
          }
        },
        "required": [
          "user",
          "tenant"
        ]
      },
      "ExpertStatus": {
        "type": "string",
        "enum": [
          "building",
          "online",
          "offline"
        ]
      },
      "Expert": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ExpertStatus"
          },
          "materialCount": {
            "type": "integer"
          },
          "chunkCount": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "materialCount",
          "chunkCount",
          "createdAt"
        ]
      },
      "CreateExpertInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "required": [
          "name"
        ]
      },
      "BuildStage": {
        "type": [
          "string",
          "null"
        ],
        "enum": [
          "queued",
          "parsing",
          "chunking",
          "embedding",
          "done"
        ],
        "description": "构建阶段，对应进度 0/20/40/70/100"
      },
      "BuildProgress": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "jobId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed"
            ]
          },
          "progress": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "stage": {
            "$ref": "#/components/schemas/BuildStage"
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "description": "失败时的可读原因"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "jobId",
          "status",
          "progress",
          "stage",
          "error",
          "updatedAt"
        ]
      },
      "ExpertDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Expert"
          },
          {
            "type": "object",
            "properties": {
              "lastBuild": {
                "$ref": "#/components/schemas/BuildProgress"
              }
            },
            "required": [
              "lastBuild"
            ]
          }
        ]
      },
      "SourceType": {
        "type": "string",
        "enum": [
          "paste",
          "file",
          "url"
        ],
        "description": "paste=粘贴正文（最可靠）；file=上传文件；url=粘贴链接（只承诺公众号）"
      },
      "Material": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sourceType": {
            "$ref": "#/components/schemas/SourceType"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "charCount": {
            "type": "integer"
          },
          "contentHash": {
            "type": "string",
            "description": "sha256，用于去重"
          },
          "chunkCount": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "sourceType",
          "title",
          "sourceUrl",
          "charCount",
          "contentHash",
          "chunkCount",
          "createdAt"
        ]
      },
      "CreateMaterialResult": {
        "type": "object",
        "properties": {
          "material": {
            "$ref": "#/components/schemas/Material"
          },
          "deduplicated": {
            "type": "boolean",
            "description": "true 表示内容哈希已存在，复用了已有素材而非新建"
          }
        },
        "required": [
          "material",
          "deduplicated"
        ]
      },
      "CreateMaterialInput": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "sourceType": {
                "type": "string",
                "enum": [
                  "paste"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "content": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100000
              }
            },
            "required": [
              "sourceType",
              "title",
              "content"
            ]
          },
          {
            "type": "object",
            "properties": {
              "sourceType": {
                "type": "string",
                "enum": [
                  "file"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "filename": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "contentBase64": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "sourceType",
              "title",
              "filename",
              "contentBase64"
            ]
          },
          {
            "type": "object",
            "properties": {
              "sourceType": {
                "type": "string",
                "enum": [
                  "url"
                ]
              },
              "url": {
                "type": "string",
                "format": "uri",
                "example": "https://mp.weixin.qq.com/s/xxxx"
              }
            },
            "required": [
              "sourceType",
              "url"
            ]
          }
        ]
      },
      "BuildResult": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "jobId"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "存活探针（不触碰任何依赖）",
        "responses": {
          "200": {
            "description": "服务存活",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "number",
                      "description": "0 = 成功；非 0 见 contracts/README.md",
                      "example": 0
                    },
                    "message": {
                      "type": "string",
                      "example": "ok"
                    },
                    "data": {
                      "$ref": "#/components/schemas/HealthData"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "就绪探针（检查数据库与 agent 可达）",
        "responses": {
          "200": {
            "description": "各依赖的状态；任一为 down 时 HTTP 仍为 200，由调用方判断",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "number",
                      "description": "0 = 成功；非 0 见 contracts/README.md",
                      "example": 0
                    },
                    "message": {
                      "type": "string",
                      "example": "ok"
                    },
                    "data": {
                      "$ref": "#/components/schemas/ReadyData"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "注册博主（同时自动创建租户）",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "注册成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "number",
                      "description": "0 = 成功；非 0 见 contracts/README.md",
                      "example": 0
                    },
                    "message": {
                      "type": "string",
                      "example": "ok"
                    },
                    "data": {
                      "$ref": "#/components/schemas/AuthResult"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "未登录或 token 失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "资源不存在，或不属于当前租户（刻意不区分，避免泄露存在性）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "登录",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "number",
                      "description": "0 = 成功；非 0 见 contracts/README.md",
                      "example": 0
                    },
                    "message": {
                      "type": "string",
                      "example": "ok"
                    },
                    "data": {
                      "$ref": "#/components/schemas/AuthResult"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "未登录或 token 失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "资源不存在，或不属于当前租户（刻意不区分，避免泄露存在性）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "当前用户与租户",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "当前身份",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "number",
                      "description": "0 = 成功；非 0 见 contracts/README.md",
                      "example": 0
                    },
                    "message": {
                      "type": "string",
                      "example": "ok"
                    },
                    "data": {
                      "$ref": "#/components/schemas/MeResult"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "未登录或 token 失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "资源不存在，或不属于当前租户（刻意不区分，避免泄露存在性）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/experts": {
      "post": {
        "tags": [
          "expert"
        ],
        "summary": "创建 AI 专家",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateExpertInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "创建成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "number",
                      "description": "0 = 成功；非 0 见 contracts/README.md",
                      "example": 0
                    },
                    "message": {
                      "type": "string",
                      "example": "ok"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Expert"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "未登录或 token 失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "资源不存在，或不属于当前租户（刻意不区分，避免泄露存在性）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "expert"
        ],
        "summary": "我的专家列表",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "number",
                      "description": "0 = 成功；非 0 见 contracts/README.md",
                      "example": 0
                    },
                    "message": {
                      "type": "string",
                      "example": "ok"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Expert"
                      }
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "未登录或 token 失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "资源不存在，或不属于当前租户（刻意不区分，避免泄露存在性）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/experts/{id}": {
      "get": {
        "tags": [
          "expert"
        ],
        "summary": "专家详情（含最近一次构建进度）",
        "description": "不属于当前租户时返回 404 而非 403 —— 不泄露资源是否存在。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "5f8c1d2e-3a4b-4c5d-9e6f-7a8b9c0d1e2f"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "详情",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "number",
                      "description": "0 = 成功；非 0 见 contracts/README.md",
                      "example": 0
                    },
                    "message": {
                      "type": "string",
                      "example": "ok"
                    },
                    "data": {
                      "$ref": "#/components/schemas/ExpertDetail"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "未登录或 token 失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "资源不存在，或不属于当前租户（刻意不区分，避免泄露存在性）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/experts/{id}/materials": {
      "post": {
        "tags": [
          "material"
        ],
        "summary": "上传素材（粘贴正文 / 文件 / 链接）",
        "description": "链接抓取只承诺公众号，其他平台尽力而为；失败时前端应引导用户改用粘贴正文。内容哈希重复时复用已有素材，返回 deduplicated: true。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "5f8c1d2e-3a4b-4c5d-9e6f-7a8b9c0d1e2f"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMaterialInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "上传成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "number",
